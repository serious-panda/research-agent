# Copy to .env at the project root and fill in your values.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Postgres — used by both docker-compose.yml and the agent checkpointer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=research
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# MCP report server
MCP_SERVER_URL=http://localhost:8000/sse

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# Agent behaviour
MAX_ITERATIONS=5
