# ── Secrets (required) ───────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Postgres ──────────────────────────────────────────────────────────────────
# Used by the postgres service and to construct POSTGRES_DSN for agent-api
POSTGRES_USER=research
POSTGRES_PASSWORD=
POSTGRES_DB=research

# ── Work mode ─────────────────────────────────────────────────────────────────
# Used when running services directly on localhost (not via Docker).
# Docker mode uses values from each service's .env.docker instead.
POSTGRES_DSN=postgresql://research:${POSTGRES_PASSWORD}@localhost:5432/research
QDRANT_URL=http://localhost:6333
MCP_SERVER_URL=http://localhost:8000/sse
